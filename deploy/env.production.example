# Vorlage für ~/immov-private/.env auf Hostpoint.
# Einmalig kopieren, Werte ausfüllen, danach: php artisan key:generate
# Diese Datei NIE mit echten Zugangsdaten ins Repository stellen.

APP_NAME=ImmoV
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://2ndgreen.com/ImmoV
APP_TIMEZONE=Europe/Zurich

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# Argon2id für Passwörter (PHP auf Hostpoint unterstützt es). Bei Problemen: bcrypt
HASH_DRIVER=argon2id

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MariaDB aus dem Hostpoint Control Panel (Datenbanken → MariaDB)
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/ImmoV
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-Mail-Versand (Passwort-Reset) über das Hostpoint-Postfach
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=asmtp.mail.hostpoint.ch
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
